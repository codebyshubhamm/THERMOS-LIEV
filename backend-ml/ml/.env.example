# THERMOS Backend Configuration (.env)

# Server Port
PORT=8000
ENVIRONMENT=development

# Required when ENVIRONMENT=production. Send it as X-API-Key from a trusted server.
THERMOS_API_KEY=
TRUSTED_HOSTS=["localhost","127.0.0.1"]

# MongoDB Configuration
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=thermos_db

# AI / LLM Configuration (Optional - Offline Tactical Engine is enabled by default)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
